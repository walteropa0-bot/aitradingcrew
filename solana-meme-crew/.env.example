# Beispiel für lokale Tests. In Replit werden diese Werte NICHT in eine Datei geschrieben,
# sondern als "Secrets" angelegt (Werkzeug-Symbol → Secrets). Siehe ANLEITUNG_REPLIT.md.
# Niemals echte Schlüssel in diese Datei oder in GitHub schreiben!

# Schützt dein Dashboard (Pflicht für den LIVE-Modus). Lang und einzigartig wählen.
DASHBOARD_PASSWORD=

# Nur für den LIVE-Modus (PAPER_TRADING = False): Private Key einer EXTRA-Wallet
# (Base58, aus Phantom: Konto → Private Key anzeigen). Nicht deine Haupt-Wallet!
SOLANA_PRIVATE_KEY=

# Eigener Solana-RPC (empfohlen für Live, z. B. kostenloser Helius-Key):
# https://mainnet.helius-rpc.com/?api-key=DEIN_KEY
SOLANA_RPC_URL=

# Optional: kostenloser Jupiter-API-Key (https://developers.jup.ag/portal) = doppelt so viele Anfragen
JUPITER_API_KEY=

# Optional: Postgres-Datenbank für dauerhaften Speicher (Replit: Tools → Database)
DATABASE_URL=

# Optional: Demo-Markt mit künstlichen Kursen (nur im Demo-Modus erlaubt)
USE_SIMULATED_MARKET=0
