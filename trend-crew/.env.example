# Beispiel für lokale Tests (Datei in ".env" kopieren und mit  `set -a; source .env; set +a`  laden).
# In Replit werden diese Werte NICHT in eine Datei geschrieben, sondern als "Secrets" angelegt
# (Werkzeug-Symbol → Secrets). Siehe ANLEITUNG_REPLIT.md.
# Niemals echte Schlüssel in diese Datei, in den Code oder nach GitHub schreiben!

# Schützt dein Dashboard (im LIVE-Modus Pflicht). Lang und einzigartig wählen.
DASHBOARD_PASSWORD=

# ── nur für den LIVE-Modus (PAPER_TRADING = False in config.py) ──
EXCHANGE=kraken
QUOTE_CURRENCY=EUR
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Höchstbetrag, den der Bot einsetzen darf (in QUOTE_CURRENCY). 0 = Live gesperrt.
LIVE_CAPITAL=0

# ── optional ──
# Postgres für dauerhaften Speicher (Replit: Tools → Database legt DATABASE_URL automatisch an)
DATABASE_URL=
# Risiko je Trade in % vom Konto (Standard 1.0) und Trailing-Stop-Abstand in ATR (Standard 5)
RISK_PER_TRADE_PCT=1.0
STOP_ATR_MULT=5
# Demo-Markt mit künstlichen Kursen (nur im Demo-Modus, kein Internet nötig)
USE_SIMULATED_MARKET=0
